- Operações com tabelas
select * from tb_cor order by 2

-- 1) Copia completa
select * into Cor1 from tb_cor
select * from cor1

select * from tb_cor order by 2
select * from cor1 order by 2

exec sp_help tb_cor -- Estrutura
exec sp_help cor1   -- Estrutura

- 2) Copia da estrutura apenas
select * into Cor2 from tb_cor where 1=0
select * from cor2


-- 3) Copiar apenas alguns registros e todos os campos
select * into Cor3 from tb_cor where cor like 'L%'
select * from cor3


-- 4) Copiar alguns campos e alguns registros
select * from tb_empregado
select nome,data_admissao into Emp1 from tb_empregado where nome like 'a%'
