-- DATEADD (p216)
-- Função DateAdd(UnidadeDeTempo,QuantidadeDeTempo,DataInicial)
-- Datas futuras ou passadas

	-- Cálculo
select 
	getdate() as [Data atual], 
	getdate()+10 as Mais10dias,
	getdate()-10 as Menos10Dias

-- Funções
select 
	getdate() as [Data atual], 
	dateadd(day,+45,getdate()) as [+45 dias],
	dateadd(day,-45,getdate()) as [-45 dias],
	dateadd(month,+16,getdate()) as [+16 meses],	
	dateadd(month,-16,getdate()) as [-16 meses],
	dateadd(week,8,getdate()) as [+8 semanas],
	dateadd(week,-15,getdate()) as [-15 semanas],
	dateadd(year,2,getdate()) as [+2 anos],
	dateadd(year,-2,getdate()) as [-2 anos]

	--Modo de apresentação das datas--- 
	select
	data_emissao as Padrão,
	cast(data_emissao as date)as[Conversão de Datatypes],
	format(data_emissao,'d','en-gb') as[Great Britain English]
	from TB_PEDIDO

-- DATEDIFF
-- Função DateDiff(UnidadeDeTempo,DataMaisAntiga,DataMaisNova)
--  Diferença de datas

-- Cálculo
select
	getdate()-'2000.01.01' as DiasCalculo,
	cast(getdate()-'2000.01.01' as int) as DiasComoInteiro

-- Funções
select 
	Nome, Data_Admissao,
	-- Subtração direta o resultado será em dias
	getdate()- data_admissao as SubtracaoDireta,
	datediff(day,Data_Admissao,getdate()) as Dias,
	datediff(week,Data_Admissao,getdate()) as Semanas,
	datediff(month,Data_Admissao,getdate()) as Meses,
	datediff(year,Data_Admissao,getdate()) as Anos,
	datediff(hour,Data_Admissao,getdate()) as Horas,
	datediff(minute,Data_Admissao,getdate()) as Minutos,
	datediff(second,Data_Admissao,getdate()) as Segundos
from tb_empregado 

