		output deleted.* 
where codcor=26

Criação da tabela de Histórico
if object_id('Historico') is not null drop table Historico
--
create table Historico
		(DataAcao Date,
		Horario time(0),
		Acao varchar(15),
		NomeUsuario varchar(20),
		--
		AntigoCod int,
		AntigoNome varchar(15),
		AntigoSalario decimal(10,2),
		--
		NovoCod int,
		NovoNome  varchar(15),
		NovoSalario decimal(10,2))

-- Inclusão de registros com Historico
merge Destino using Origem ON destino.cod=origem.cod
when not matched by target then 
insert (cod,Nome) values (origem.cod,origem.Nome)
output
		getdate() as DataAcao,
		cast(getdate() as time(0)) as Horario,
		$Action as Acao,
		user_name(),
		--
		Deleted.Cod as AntigoCod,
		Deleted.Nome as AntigoNome,
		Deleted.Salario as AntigoSalario,
		--
		Inserted.Cod as NovoCod,
		Inserted.Nome as NovoNome,
		Inserted.Salario as NovoSalario
into Historico;

-- Depois
select * from Origem
select * from Destino
select * from Historico

-----------------------------------------------------
--  Alteração de registros (com tabela, com output)
merge Destino using Origem ON destino.cod=origem.cod
when matched and Destino.salario is null
then update set Destino.Salario=Origem.Salario
output
		getdate() as DataAcao,
		cast(getdate() as time(0)) as Horario,
		$Action as Acao,
		user_name(),
		--
		Deleted.Cod as AntigoCod,
		Deleted.Nome as AntigoNome,
		Deleted.Salario as AntigoSalario,
		--
		Inserted.Cod as NovoCod,
		Inserted.Nome as NovoNome,
		Inserted.Salario as NovoSalario
into Historico;
--
select * from Origem
select * from Destino
select * from Historico

-----------------------------------------------------
-- H) Exclusão de registros com tabela
merge Destino using Origem ON destino.cod=origem.cod
when not matched by source then delete  
output
		getdate() as DataAcao,
		cast(getdate() as time(0)) as Horario,
		$Action as Acao,
		user_name(),
		--
		Deleted.Cod as AntigoCod,
		Deleted.Nome as AntigoNome,
		Deleted.Salario as AntigoSalario,
		--
		Inserted.Cod as NovoCod,
		Inserted.Nome as NovoNome,
		Inserted.Salario as NovoSalario
into Historico;
--
select * from Origem
select * from Destino
select * from Historico
