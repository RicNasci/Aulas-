-- Diferentes naturezas para campos data e hora (data types)
-- CAST = Converte uma expressão (digitada ou calculada) de um tipo de dado em outra

-- Datas
select  
	getdate() as 'DataHorarioWindows', 
	sysdatetime() as 'DataHorarioWindowsMaiorPrecisao', 
	cast(getdate() as date) as 'Conversao_Date', 
	cast(getdate() as datetime2) as 'Conversao_DateTime2',
	cast(getdate() as smalldatetime) as 'Conversao_Smalldatetime'

-- Horários
select 
	getdate() as 'DataHorarioWindows', 
	cast(getdate() as time) as 'Conversao_Time',
	cast(getdate() as time(0)) as 'Conversão_Time(0)',
	cast(getdate() as time(1)) as 'Conversão_Time(1)',
	cast(getdate() as time(2)) as 'Conversão_Time(2)',
	cast(getdate() as time(3)) as 'Conversão_Time(3)'
