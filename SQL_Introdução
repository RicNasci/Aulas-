-- EOMONTH (p221)

-- EOMONTH(DataInicial,+-QtdMeses) -- end of month
-- Data completa (dia, mês, ano) do último dia do mês. 
-- Identifica o último dia do mes da data indicada
select 
	eomonth(getdate(),0) as [Data do último dia do mês um uso],
	eomonth(getdate(),15) as [Data do último dia mês daqui a 15 meses],
	eomonth(getdate(),-14) as [Data do último dia mês, 14 meses passados]

