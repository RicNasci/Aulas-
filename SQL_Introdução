	(103,'Juvia',7000)

insert into Destino values
	(104,'Conrado',15000),
	(105,'Antonio',null),
	(106,'Anastolfo',7000)
--
select * from Origem
select * from Destino

-- A clausula OUPUT permite apresentar em tela os registros incluidos, alterados ou excluidos
if object_id('TesteOutput') is  not null drop table TesteOutput
select * into TesteOutput from tb_cor
select * from testeoutput
--
-- Incluir
insert  into testeoutput 
		output inserted.* 
values ( 26,'Azul Brilhante')

-- Modificar
update TesteOutput set cor='Incolor' 
		output 
			deleted.cor as 'Apagado', 
			inserted.cor as 'Novo'
where codcor=1

-- Excluir
