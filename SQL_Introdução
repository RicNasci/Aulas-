-- Calcular o novo salario com aumento por intervalo de tempo de trabalho
-- Por exemplo, se o empregado tem de 0 a 15 anos de casa, receberá um 
-- aumento de 10%
---- 0 a 15 .......... 10%
---- 16 a 35 ........ 20%
---- 36 a 40 ........ 30%
---- 41 e além ..... 45%

-- Com CASE
select Nome, 
	Data_Admissao, 
	Salario, 
	datediff(year,Data_Admissao,getdate()) as TempoDeCasa,
		case
			when datediff(year,Data_Admissao,getdate())  between 0 and 15 then salario*1.1
			when datediff(year,Data_Admissao,getdate())  between 16 and 35 then salario*1.2
			when datediff(year,Data_Admissao,getdate())  between 36 and 40 then salario*1.3
			when datediff(year,Data_Admissao,getdate())  >=41 then salario*1.45
		else 
			salario
		end [Novo Salario]
from tb_empregado
where salario is not null

-- Com IIF
select nome,
       data_admissao, 
	   salario,
	    datediff(year, data_admissao, getdate()) AS tempo_de_casa,
        IIF(datediff(year, data_admissao, getdate()) <= 15, salario * 1.10,
        IIF(datediff(year, data_admissao, getdate()) between 16 AND 35, salario * 1.20,
        IIF(datediff(year, data_admissao, getdate()) between 36 AND 40, salario * 1.30, salario * 1.45))) AS novo_salario
from tb_empregado
where data_admissao is not null 
and salario is not null 
order by data_admissao


