-- 1) Listar o nome do funcionario, data de admissao, salario e uma coluna calculada com
--     aumento de 10% para quem tem entre 20 e 25 anos de trabalho. Atribuir uma legenda 
para a coluna calculada

 SELECT 
  NOME, 
  YEAR(GETDATE()) - YEAR(data_admissao) AS TempoDeCasa,
  SALARIO,
  SALARIO * 1.1 AS SIMULACAO
FROM tb_empregado
WHERE YEAR(GETDATE()) - YEAR(data_admissao) BETWEEN 20 AND 25
ORDER BY TempoDeCasa DESC


