-- IIF
-- A função IIF verifica uma condição e retorna caso verdade ou caso falso
-- IIF(TesteLogico,ParteVerdadeira,ParteFalsa)
-- iif(ExpressaoComparativa com resposta true ou false, Ação caso true, Ação caso False)
-- Na tabela tb_produto 
-- Se a quantidade real for menor do que a quantidade minima, aumentar o preço em 10%. 
-- Se for quantidade real for maior do que a quantidade minima diminuir o preço de venda em 10%.
-- Se for igual, manter o preço. Apresentar o preço final com apenas 
-- 2 casas decimais  - Não é formato

-- Listar os dados todos
select * from tb_produto
select 
	descricao,
	qtd_real,
	qtd_minima, 
	preco_venda,
    iif(qtd_real<qtd_minima,preco_venda*1.10,
    iif(qtd_real>qtd_minima,preco_venda*0.9,preco_venda)) 
as [Ajustar o Preço]
from tb_produto
-- Criar uma listagem que verifique os produtos que devem ser reabastecidos, 
-- que são aqueles onde a quantidade real é menor do que a quantidade minima. 
-- Na coluna do resultado apresentar a frase "Comprar mais". 
-- Listar APENAS os produtos que devem se comprados
select 
	descricao,
	qtd_real,
	qtd_minima,
	IIF(qtd_real<=qtd_minima,'Comprar mais','Não Comprar') as Recomendacao,
	'Comprar mais' as Recomendacao
from tb_Produto	where 
	qtd_real is not null	 and
	qtd_minima is not null and
	qtd_real<=qtd_minima
order by 2

