--	MERGE (p382)
-- Sincronizar duas tabelas, inserindo, atualizando ou excluindo linhas de uma tabela de destino 
-- com base nas diferenças em relação aos dados de origem

-- No SQL Server, é possível executar operações de inserção, atualização ou exclusão 
-- em uma única instrução usando MERGE

-- Inserir ou atualizar linhas em uma única tabela de destino condicionalmente. Se a linha existir 
-- na tabela de destino, atualize uma ou mais colunas; caso contrário, insira os dados em 
-- uma nova linha

-- As alterações (dados inseridos, alterados, excluidos) podem ser apresentados em tela 
-- ou salvos em tabelas instrução


-- A) Montagem
if object_id('Origem', 'U') is not null drop table Origem
if object_id('Destino', 'U') is not null drop table Destino

create table Origem
	(Cod int, 
	 Nome varchar(50),
	 Salario numeric(10,2)
	 constraint OrigemPK primary key (Cod))

create table Destino
	(Cod int, 
	 Nome varchar(50),
	 Salario numeric(10,2)
	 constraint DestinoPK primary key (Cod))

insert into Origem values 
	(100,'Eleonora',10000),
