-- DELETE
-- Delete - Apaga apenas registros identificados pelo where ou todos se não houver filtro
-- Não reinicia o identity da chave primária (PK)
select * into CopiaCargo1 from tb_cargo
select * from CopiaCargo1

-- 1) Excluindo alguns registros
delete from copiacargo1 where cod_cargo in (5,6,7)
select * from CopiaCargo1

-- 2) Excluir todos os registros 
--     Apagará todos os registros, mas manterá a sequencia anterior da PK (função identity)
delete from copiacargo1 -- Todos os resgistros
select * from CopiaCargo1

-----
