-- DATEPART  - DATEADD - DATENAME - DATEDIFF -  (p212)

-- Função DatePart(UnidadeDeTempo, DataAnalisada)
-- Função DateAdd(UnidadeDeTempo,QuantidadeDeTempo,DataInicial)
-- Função DateName(UnidadeDeTempo, DataAnalisada)
-- Função DateDiff(UnidadeDeTempo,DataMaisAntiga,DataMaisNova)

-- Exemplos
select datepart(week,getdate())			-- semana do ano em que estamos
select datepart(week,'2024.12.01')	    -- semana do ano em que estamos
select nome, data_nascimento, datepart(week,data_nascimento) from tb_empregado order by 3 
select nome, data_nascimento, datepart(week,data_nascimento)  from tb_empregado 
where datepart(week,data_nascimento)=37

select 
	num_pedido,
	Data_Emissao, 
	day(Data_Emissao) as 'Dia',
	month(Data_Emissao) as 'Mes',
	year(Data_Emissao) as 'Ano'
from tb_Pedido

select
	num_pedido,
	Data_Emissao,
	datepart(day,data_emissao) as 'Dia do Mes',
	datepart(quarter,Data_Emissao) as 'Trimestre',
	datepart(week,Data_Emissao) as 'SemanaDoAno-SQL',
	datepart(iso_week,Data_Emissao) as 'SemanaDoAno-ISO',
	datepart(weekday,Data_Emissao) as 'Dia da Semana',
	datepart(hour,Data_Emissao) as 'Hora',
	datepart(minute,Data_Emissao) as 'Minuto'
from tb_Pedido

select
	num_pedido,
	Data_Emissao,
	datename(week,Data_Emissao) as 'Número da semana no ano',
	datename(quarter,Data_Emissao) as 'Trimestre do ano',
	datename(weekday,Data_Emissao) as 'NomeDiaSemana',
    datename(dayofyear,Data_emissao) as 'Dia do Ano',
    datename(month,Data_emissao) as 'NomeMes'
from tb_Pedido

